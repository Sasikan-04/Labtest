<!doctype html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Mellow Bite | เมนูทำง่าย</title>

    <link rel="stylesheet" href="css/bootstrap.min.css">
    <link rel="stylesheet" href="css/style.css">
</head>

<body>


<%- include('partials/navbar') %>


<header class="page-header page-header-yellow">
    <div class="container">

        <div class="section-label"
            style="color:#bf9c35;">
            ✦ QUICK & EASY
        </div>

        <h1 class="page-title mt-2">
            เมนูทำง่าย
        </h1>

        <p class="section-description">
            สำหรับวันที่หิว แต่ไม่อยากใช้เวลาอยู่ในครัวนาน
        </p>


        <div class="quick-info mt-4">

            <div class="row align-items-center">

                <div class="col-md-auto">

                    <div class="quick-icon">
                        ◷
                    </div>

                </div>

                <div class="col mt-3 mt-md-0">

                    <h5 class="mb-1">
                        เสร็จใน 15 นาที
                    </h5>

                    <div class="text-muted">
                        เมนูเร็ว วัตถุดิบน้อย มือใหม่ทำได้
                        ไม่ต้องรอนาน
                    </div>

                </div>

                <div class="col-md-auto mt-3 mt-md-0 text-muted">
                    ◷ 5–15 นาที · 4–5 วัตถุดิบ · ง่ายมาก
                </div>

            </div>

        </div>

    </div>
</header>


<main class="section-padding">
    <div class="container">
        <div class="row g-4">

            <div class="row g-4">

                <% recipes.forEach(function (recipe) { %>

                    <%- include(
                        'partials/recipe-card',
                        { recipe: recipe }
                    ) %>

                <% }); %>

            </div>

        </div>
    </div>
</main>


<footer class="main-footer">
    <div class="container">

        <h5>Mellow Bite</h5>

        <p class="text-muted">
            สูตรง่าย ๆ สำหรับทุกวันที่อยากกินของอร่อย
        </p>

        <hr>

        <small class="text-muted">
            Mellow Bite 
        </small>

    </div>
</footer>


<script src="js/bootstrap.bundle.min.js"></script>
<script src="js/script.js"></script>

</body>
</html>