<!-- การ์ดกลาง -->
<div class="col-lg-4 col-md-6">

    <div class="recipe-card h-100 position-relative">

        <img
            src="/<%= recipe.image %>"
            alt="<%= recipe.title %>"
            class="card-img-top">

        <div class="p-4">

            <% if (recipe.english) { %>

                <div class="recipe-en">
                    <%= recipe.english %>
                </div>

            <% } %>

            <h5 class="recipe-title">
                <%= recipe.title %>
            </h5>

            <% if (recipe.description) { %>

                <p class="text-muted">
                    <%= recipe.description %>
                </p>

            <% } %>


            <div class="recipe-meta mb-3">

                <span>
                    ⏱ <%= recipe.time_text %>
                </span>

                <span class="difficulty-badge">
                    <%= recipe.difficulty %>
                </span>

            </div>


            <a
                href="/recipe?id=<%= recipe.slug %>"
                class="recipe-link">

                ดูสูตร →

            </a>

            <%
                if (
                    typeof favoriteMode !== 'undefined'
                    &&
                    favoriteMode
                ) {
            %>

                <form
                    action="/favorites/toggle"
                    method="POST"
                    class="mt-3">

                    <input
                        type="hidden"
                        name="recipeSlug"
                        value="<%= recipe.slug %>">

                    <button
                        type="submit"
                        class="btn btn-outline-danger btn-sm">

                        ♥ เอาออกจากรายการ

                    </button>

                </form>

            <% } %>

        </div>

    </div>

</div>