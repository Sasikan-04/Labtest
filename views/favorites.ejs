<!doctype html>
<html lang="th">

<head>

    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1">

    <title>
        Mellow Bite | สูตรที่บันทึก
    </title>

    <link
        rel="stylesheet"
        href="/css/bootstrap.min.css">

    <link
        rel="stylesheet"
        href="/css/style.css">

</head>

<body>

<%- include('partials/navbar') %>


<header class="page-header page-header-pink">

    <div class="container">

        <div class="section-label">
            MY FAVORITES
        </div>

        <h1 class="page-title">
            ♡ สูตรที่บันทึกไว้
        </h1>

        <p class="section-description">
            สูตรโปรดของ
            <%= currentUser.username %>
        </p>

    </div>

</header>

<main class="section-padding">

    <div class="container">

        <% if (recipes.length === 0) { %>

            <div class="text-center py-5">

                <h2 class="h4">
                    ยังไม่มีสูตรที่บันทึกไว้
                </h2>

                <p class="text-muted">
                    เลือกสูตรที่ชอบแล้วกด
                    ♡ บันทึกสูตร
                </p>

                <a
                    href="/"
                    class="btn btn-recipe">

                    ดูสูตรอาหาร

                </a>

            </div>


        <% } else { %>

            <div class="row g-4">

                <% recipes.forEach(
                    function (recipe) {
                %>

                    <%- include(
                        'partials/recipe-card',
                        {
                            recipe: recipe,
                            favoriteMode: true
                        }
                    ) %>

                <% }); %>

            </div>

        <% } %>

    </div>

</main>

</script>

<script src="/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js"></script>

</body>

</html>