<!doctype html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Mellow Bite | สมัครสมาชิก</title>
                                <!-- เริ่มจาก root ของเว็บ -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>


<%- include('partials/navbar') %>


<main class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-7">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">

                            <div class="section-label">
                                CREATE ACCOUNT
                            </div>

                            <h1 class="h3 mt-2">
                                สมัครสมาชิก
                            </h1>

                            <p class="text-muted">
                                สมัครเพื่อบันทึกสูตรโปรดของคุณ
                            </p>

                        </div>


                        <% if (error) { %>

                            <div class="alert alert-danger">
                                <%= error %>
                            </div>

                        <% } %>


                        <form action="/register" method="POST">

                            <div class="mb-3">

                                <label
                                    for="username"
                                    class="form-label">
                                    ชื่อผู้ใช้
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    id="username"
                                    name="username"
                                    value="<%= values.username %>"
                                    required>

                            </div>


                            <div class="mb-3">

                                <label
                                    for="email"
                                    class="form-label">
                                    อีเมล
                                </label>

                                <input
                                    type="email"
                                    class="form-control"
                                    id="email"
                                    name="email"
                                    value="<%= values.email %>"
                                    required>

                            </div>


                            <div class="mb-4">

                                <label
                                    for="password"
                                    class="form-label">
                                    รหัสผ่าน
                                </label>

                                <input
                                    type="password"
                                    class="form-control"
                                    id="password"
                                    name="password"
                                    required>

                                <div class="form-text">
                                    อย่างน้อย 8 ตัวอักษร
                                </div>

                            </div>


                            <button
                                type="submit"
                                class="btn btn-recipe w-100">

                                สมัครสมาชิก

                            </button>

                        </form>


                        <div class="text-center mt-4">

                            <span class="text-muted">
                                มีบัญชีอยู่แล้ว?
                            </span>

                            <a href="/login" class="recipe-link">
                                เข้าสู่ระบบ
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</main>


<script src="/js/bootstrap.bundle.min.js"></script>

</body>
</html>